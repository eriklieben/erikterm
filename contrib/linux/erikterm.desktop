[Desktop Entry]
Type=Application
Version=1.5
Name=Erik's Terminal
GenericName=Terminal
Comment=GPU-accelerated terminal with tabs, splits and coding-agent status
Exec=erikterm
TryExec=erikterm
Icon=erikterm
Terminal=false
Categories=System;TerminalEmulator;
Keywords=erikterm;shell;prompt;command;commandline;cmd;terminal;console;
StartupNotify=true
StartupWMClass=erikterm
Actions=new-window;

# With single_instance (the default) a second launch opens a window in the running erikterm.
[Desktop Action new-window]
Name=New Window
Exec=erikterm
