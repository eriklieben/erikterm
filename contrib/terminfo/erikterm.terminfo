# xterm-erikterm: terminfo for erikterm. GENERATED from src/ErikTerm.Core/TermCapabilities.cs
# (the same table answers XTGETTCAP): edit that file, then run `erikterm --terminfo > contrib/terminfo/erikterm.terminfo`.
# Install: scripts/install-terminfo.sh (tic -x -o ~/.terminfo). On another machine (ssh):
#   infocmp -x xterm-erikterm | ssh HOST 'tic -x -o ~/.terminfo /dev/stdin'
xterm-erikterm|erikterm terminal emulator,
	Tc,
	Su,
	fullkbd,
	colors#256,
	Smulx=\E[4:%p1%dm,
	Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%dm,
	Smol=\E[53m,
	Rmol=\E[55m,
	smxx=\E[9m,
	rmxx=\E[29m,
	Ss=\E[%p1%d q,
	Se=\E[0 q,
	Cs=\E]12;%p1%s\007,
	Cr=\E]112\007,
	cnorm=\E[?25h,
	Ms=\E]52;%p1%s;%p2%s\007,
	Sync=\E[?2026%?%p1%{1}%-%tl%eh%;,
	BE=\E[?2004h,
	BD=\E[?2004l,
	PS=\E[200~,
	PE=\E[201~,
	fe=\E[?1004h,
	fd=\E[?1004l,
	XM=\E[?1006;1000%?%p1%{1}%=%th%el%;,
	XR=\E[>0q,
	kbs=^?,
	cvvis@,
	smm@,
	rmm@,
	smglp@,
	smglr@,
	smgrp@,
	mgc@,
	use=xterm-256color,
