<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for the off-screen integration scenarios (dotnet-coverage collect in
     scripts/integration-tests.sh and the integration jobs of .github/workflows/build.yml). The tests start erikterm as
     a process of its own: dotnet-coverage measures the processes the test run starts, and this counts the app and its
     four libraries, only their source files under src/ (not the tests, not generated code under obj/).
     docs/development/code-analysis.md. An XML comment may not contain two hyphens in a row. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]erikterm\.dll$</ModulePath>
        <ModulePath>.*[\\/]ErikTerm\.(Core|Config|Ui|Pty)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Include>
        <Source>.*[\\/]src[\\/]ErikTerm\.[A-Za-z]+[\\/].*</Source>
      </Include>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
