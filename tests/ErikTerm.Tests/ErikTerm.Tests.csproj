<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only packages are allowed; the shipped binaries (src/, bench/) take no packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ErikTerm.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Linked app sources: fields the app assigns (renderer caches, selections) can look unassigned here. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- TUnit on Microsoft.Testing.Platform: the project is its own runner (dotnet run / dotnet test, see global.json). -->
    <PackageReference Include="TUnit" Version="1.81.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- CollectionOrdering (ordered IsEquivalentTo) and OS ([RunOn] / [ExcludeOn]). -->
    <Using Include="TUnit.Assertions.Enums" />
    <Using Include="TUnit.Core.Enums" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ErikTerm.Core/ErikTerm.Core.csproj" />
    <ProjectReference Include="../../src/ErikTerm.Config/ErikTerm.Config.csproj" />
    <ProjectReference Include="../../src/ErikTerm.Pty/ErikTerm.Pty.csproj" />
    <ProjectReference Include="../../src/ErikTerm.Ui/ErikTerm.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- All of the app (an AOT exe with native deps) is compiled in, so tests can reach any of it and the coverage
         report counts every App line, not only the files a test happened to need (docs/development/code-analysis.md).
         Program.cs is left out: its Main would clash with the test runner's entry point. -->
    <Compile Include="../../src/ErikTerm.App/**/*.cs" Exclude="../../src/ErikTerm.App/bin/**;../../src/ErikTerm.App/obj/**;../../src/ErikTerm.App/Program.cs" LinkBase="App" />
  </ItemGroup>
  <!-- The app's embedded window icon, so WindowIconTests decodes the same resource. -->
  <Import Project="../../build/AppIcon.props" />
  <!-- contrib/shell, embedded like in the app (ShellIntegrationInjectionTests extracts and runs it). -->
  <Import Project="../../build/ShellIntegration.props" />
</Project>
