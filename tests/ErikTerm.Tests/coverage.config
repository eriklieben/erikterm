<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings (Microsoft.Testing.Extensions.CodeCoverage), passed with the coverage-settings option of
     dotnet test in .github/workflows/build.yml. Note: an XML comment may not contain two hyphens in a row, so the
     option isn't spelled out here; a comment that does makes the tool reject the whole file as invalid.

     The tests compile many of ErikTerm.App's source files into the test assembly itself (see ErikTerm.Tests.csproj),
     and the coverage tool leaves test assemblies out by default, so that code ran but was never counted. This takes
     the test assembly in as well, but counts only source files under src/: the tests' own code stays out.
     docs/development/code-analysis.md. -->
<Configuration>
  <!-- A top-level setting, a sibling of CodeCoverage: nested inside CodeCoverage it is silently ignored. -->
  <IncludeTestAssembly>true</IncludeTestAssembly>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]ErikTerm\.(Core|Config|Ui|Pty|Tests)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Include>
        <Source>.*[\\/]src[\\/]ErikTerm\.[A-Za-z]+[\\/].*</Source>
      </Include>
      <!-- Generated code (source generators write it under obj/): the marshalling stubs aren't ours to test. -->
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
